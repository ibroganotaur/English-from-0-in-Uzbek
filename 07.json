        { "uz": "Suv sovuq.",       "en": "The water is cold." },
        { "uz": "Qornim och.",      "en": "I am hungry." },
        { "uz": "Men 27 yoshdaman.", "en": "I am 27 years old." }
      ]
    }
  ],

