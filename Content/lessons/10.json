  "rules": [
    {
      "label": "Suhbat 1 · Tanishuv",
      "body": "Bu suhbatni <b>yod oling</b> va ovoz chiqarib oʻqing. Har bir gap 1–9-darslarda oʻrgangan qoidalardan tuzilgan.\n\n— <b>Hello! My name is Aziza.</b>\n<i>Salom! Mening ismim Aziza.</i>\n\n— <b>Hi, Aziza. I'm Sara. Nice to meet you.</b>\n<i>Salom, Aziza. Men Saraman. Tanishganimdan xursandman.</i>\n\n— <b>Nice to meet you too. Where are you from?</b>\n<i>Men ham. Siz qayerdansiz?</i>\n\n— <b>I'm from England. And you?</b>\n<i>Men Angliyadanman. Siz-chi?</i>\n\n— <b>I'm from Uzbekistan. I'm a teacher.</b>\n<i>Men Oʻzbekistondanman. Men oʻqituvchiman.</i>\n\n— <b>Are you married?</b>\n<i>Turmush qurganmisiz?</i>\n\n— <b>Yes, I am. I have two children.</b>\n<i>Ha. Mening ikkita bolam bor.</i>",
      "examples": []
    },
    {
      "label": "Suhbat 2 · Doʻkonda",
      "body": "— <b>Hello. How much is this?</b>\n<i>Salom. Bu qancha turadi?</i>\n\n— <b>It's five dollars.</b>\n<i>Besh dollar.</i>\n\n— <b>That's expensive. How much are these apples?</b>\n<i>Bu qimmat. Bu olmalar qancha?</i>\n\n— <b>They're two dollars.</b>\n<i>Ikki dollar.</i>\n\n— <b>OK. Two apples and one banana, please.</b>\n<i>Yaxshi. Ikkita olma va bitta banan, iltimos.</i>\n\n— <b>Here you are.</b>\n<i>Mana, oling.</i>\n\n— <b>Thank you. Goodbye!</b>\n<i>Rahmat. Xayr!</i>",
      "examples": []
    },
    {
      "label": "Diqqat · narx soʻrash",
      "body": "Birlik va koʻplikka eʼtibor bering:\n\n<b>How much is this?</b> — bitta narsa\n<b>How much are these?</b> — bir nechta narsa\n\nBu 6-darsdagi «this / these» qoidasining aynan oʻzi.",
      "examples": []
    }
  ],

  "examples": [
    { "en": "Hello! My name is Aziza.", "uz": "Salom! Mening ismim Aziza." },
    { "en": "Where are you from?",      "uz": "Siz qayerdansiz?" },
    { "en": "How much is this?",        "uz": "Bu qancha turadi?" },
    { "en": "Two apples, please.",      "uz": "Ikkita olma, iltimos." }
