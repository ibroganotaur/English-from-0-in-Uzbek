  "rules": [
    {
      "label": "Qoida 1 · alohida soʻz",
      "body": "Oʻzbekchada egalik otning oxiriga qoʻshiladi: «kitob<b>im</b>», «uy<b>ingiz</b>».\n\nInglizchada esa <b>alohida soʻz otdan oldin</b> turadi:\n\nkitobim → <b>my book</b>\nuyingiz → <b>your house</b>\noilamiz → <b>our family</b>\n\nEgalik soʻzi bor boʻlsa, artikl qoʻyilmaydi: «a my book» emas, shunchaki «my book».",
      "examples": []
    },
    {
      "label": "Qoida 2 · his yoki her?",
      "body": "Bu <b>egasiga</b> qarab tanlanadi, narsaga qarab emas.\n\nEga ayol boʻlsa — har doim <b>her</b>, keyin nima kelishidan qatʼi nazar.\nEga erkak boʻlsa — har doim <b>his</b>.",
      "examples": [
        { "uz": "Aziza va uning eri",    "en": "Aziza and her husband" },
        { "uz": "Aziz va uning xotini",  "en": "Aziz and his wife" }
      ]
    },
    {
      "label": "Qoida 3 · 's",
      "body": "Odam nomidan keyin <b>'s</b> qoʻyiladi. Tartib oʻzbekchadagidek — egasi oldin, narsa keyin.\n\nAzizaning kitobi → <b>Aziza's book</b>\nakamning mashinasi → <b>my brother's car</b>",
      "examples": []
    }
  ],

  "examples": [
    { "en": "This is my family.",       "uz": "Bu mening oilam." },
    { "en": "What is your name?",       "uz": "Sizning ismingiz nima?" },
    { "en": "Her mother is a teacher.", "uz": "Uning onasi oʻqituvchi." },
    { "en": "Aziza's house is big.",    "uz": "Azizaning uyi katta." }
  ],

  "warning": {
    "body": "<b>his</b> va <b>her</b> egasiga qarab tanlanadi — bu oʻzbek tilida umuman yoʻq farq, shuning uchun eng koʻp shu yerda adashiladi.",
    "pairs": [
      { "bad": "Aziza and his husband",   "good": "Aziza and her husband" },
      { "bad": "the book of my brother",  "good": "my brother's book" },
      { "bad": "My name Aziza.",          "good": "My name is Aziza." }
    ]
  },

