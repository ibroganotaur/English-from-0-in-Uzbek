  "rules": [
    {
      "label": "Qoida",
      "body": "Oʻzbekchada «talaba<b>man</b>» — qoʻshimcha soʻzning oxiriga yopishadi.\n\nInglizchada u <b>alohida soʻz</b> boʻlib, egadan keyin turadi:",
      "examples": [
        { "uz": "Men talabaman.", "en": "I am a student." },
        { "uz": "Siz oʻqituvchisiz.", "en": "You are a teacher." }
      ]
    },
    {
      "label": "Qoida · qisqartirish",
      "body": "Gapirganda deyarli har doim qisqartiriladi. Yozuvda ham shunday yozish mumkin.\n\n<b>I am</b> → <b>I'm</b>  <code>AYM</code>\n<b>You are</b> → <b>You're</b>  <code>YUR</code>\n\nVa yana: <b>I</b> harfi gapning oʻrtasida ham har doim katta yoziladi. Bu ingliz tilidagi yagona shunday soʻz.",
      "examples": []
    }
  ],

  "examples": [
    { "en": "I am a student.",        "uz": "Men talabaman." },
    { "en": "I am from Uzbekistan.",  "uz": "Men Oʻzbekistondanman." },
    { "en": "You are a teacher.",     "uz": "Siz oʻqituvchisiz." },
    { "en": "You are here.",          "uz": "Siz bu yerdasiz." }
  ],

  "warning": {
    "body": "Egani tushirib qoldirmang. Oʻzbekchada mumkin, inglizchada — <b>hech qachon</b>.",
    "pairs": [
      { "bad": "Am a teacher.",        "good": "I am a teacher." },
      { "bad": "Are from Uzbekistan.", "good": "You are from Uzbekistan." }
    ]
  },

