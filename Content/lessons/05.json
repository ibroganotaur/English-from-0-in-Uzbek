  "rules": [
    {
      "label": "Qoida 1 · inkor",
      "body": "«be» dan keyin <b>not</b> qoʻshiladi. Boshqa hech narsa oʻzgarmaydi.\n\nI am <b>not</b> → <b>I'm not</b>\nHe is <b>not</b> → <b>he isn't</b>\nThey are <b>not</b> → <b>they aren't</b>",
      "examples": [
        { "uz": "Men shifokor emasman.", "en": "I'm not a doctor." },
        { "uz": "U uyda emas.",          "en": "He isn't at home." }
      ]
    },
    {
      "label": "Qoida 2 · savol",
      "body": "Oʻzbekchada savol qilish uchun oxiriga <b>-mi</b> qoʻshiladi: «Talabasizmi?»\n\nInglizchada esa <b>soʻz tartibi oʻzgaradi</b> — «be» oldinga chiqadi.",
      "examples": [
        { "uz": "Siz talabasiz. → Siz talabamisiz?", "en": "You are a student. → Are you a student?" },
        { "uz": "U singlingiz. → U singlingizmi?",   "en": "She is your sister. → Is she your sister?" }
      ]
    },
    {
      "label": "Qoida 3 · qisqa javob",
      "body": "Inglizchada quruq «Yes» yoki «No» qoʻpol eshitiladi. Har doim shunday javob bering:\n\n<b>Are you a student?</b>\n→ Yes, I <b>am</b>. / No, I'<b>m not</b>.\n\n<b>Is he at home?</b>\n→ Yes, he <b>is</b>. / No, he <b>isn't</b>.\n\nDiqqat: «Yes, I am» qisqartirilmaydi. «Yes, I'm» deyilmaydi.",
      "examples": []
    }
  ],

  "examples": [
    { "en": "I'm not tired.",            "uz": "Men charchamaganman." },
    { "en": "Are you busy?",             "uz": "Bandmisiz?" },
    { "en": "Is she your sister?",       "uz": "U singlingizmi?" },
    { "en": "No, they aren't ready.",    "uz": "Yoʻq, ular tayyor emas." }
  ],

  "warning": {
    "body": "Faqat ohangni koʻtarib savol qilmang — <b>soʻz tartibini</b> oʻzgartiring. Bu oʻzbekcha «-mi» odatidan qoladigan xato.",
    "pairs": [
      { "bad": "You are a student?",   "good": "Are you a student?" },
      { "bad": "She is ready?",        "good": "Is she ready?" },
      { "bad": "Yes, I'm.",            "good": "Yes, I am." }
    ]
  },

