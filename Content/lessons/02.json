  "rules": [
    {
      "label": "Qoida · toʻliq jadval",
      "body": "«Be» feʼlining uchta shakli bor. Buni yod oling — u ingliz tilining tayanchi.\n\n<b>I</b> → am\n<b>he / she / it</b> → is\n<b>you / we / they</b> → are\n\nQisqargan shakli:\n<b>he's · she's · it's · we're · they're</b>",
      "examples": []
    },
    {
      "label": "Qoida · «u» boʻlinadi",
      "body": "Oʻzbekchada erkak ham, ayol ham, narsa ham — hammasi <b>u</b>. Inglizchada esa uchta boshqa soʻz:\n\n<b>he</b> — erkak\n<b>she</b> — ayol\n<b>it</b> — narsa, hayvon",
      "examples": [
        { "uz": "U mening erim. U shifokor.",     "en": "He is my husband. He is a doctor." },
        { "uz": "U mening singlim. U talaba.",    "en": "She is my sister. She is a student." },
        { "uz": "Bu kitob. U yangi.",             "en": "This is a book. It is new." }
      ]
    }
  ],

  "examples": [
    { "en": "He is my brother.",        "uz": "U mening akam." },
    { "en": "She is a teacher.",        "uz": "U oʻqituvchi." },
    { "en": "We are from Uzbekistan.",  "uz": "Biz Oʻzbekistondanmiz." },
    { "en": "They are here.",           "uz": "Ular bu yerda." }
  ],

  "warning": {
    "body": "Bu — oʻzbeklarning <b>eng koʻp</b> qiladigan xatosi.\n\nGapirishdan oldin bir soniya toʻxtang va oʻzingizdan soʻrang: «kim haqida gapiryapman — erkakmi, ayolmi?»\n\nAyolni «he» desangiz, suhbatdosh toʻxtab qoladi. Shuning uchun birinchi kundan toʻgʻri oʻrganing.",
    "pairs": [
      { "bad": "My sister? He is a doctor.", "good": "My sister? She is a doctor." },
      { "bad": "My husband? She is here.",   "good": "My husband? He is here." }
    ]
  },

