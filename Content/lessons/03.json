  "rules": [
    {
      "label": "Qoida 1 · a va an",
      "body": "Sanaladigan <b>bitta</b> narsa haqida birinchi marta gapirsangiz, oldiga <b>a</b> qoʻyiladi. Bu «bitta, qandaydir» degani.\n\nAgar soʻz <b>unli tovush</b> bilan boshlansa — <b>an</b>:\n\n<b>a</b> book · <b>a</b> chair · <b>a</b> shop · <b>a</b> doctor\n<b>an</b> apple · <b>an</b> orange · <b>an</b> egg",
      "examples": []
    },
    {
      "label": "Qoida 2 · tovush, harf emas",
      "body": "Muhimi — <b>tovush</b>, yozilishi emas.\n\n<b>an hour</b>  <code>en AUER</code> — «h» aytilmaydi, shuning uchun «an»\n<b>a university</b>  <code>e yu-ni-VOO-si-ti</code> — «yu» tovushi bilan boshlanadi, shuning uchun «a»",
      "examples": []
    },
    {
      "label": "Qoida 3 · the",
      "body": "<b>the</b> — «oʻsha». Ikkalamiz ham qaysi narsa haqida gapirayotganimizni bilamiz.\n\nBirinchi marta — <b>a</b>. Ikkinchi marta — <b>the</b>.\n\nVa dunyoda yagona narsalar oldida ham «the»: <b>the sun</b>, <b>the moon</b>.",
      "examples": [
        { "uz": "Menda mashina bor. Oʻsha mashina eski.", "en": "I have a car. The car is old." }
      ]
    }
  ],

  "examples": [
    { "en": "This is a chair.",   "uz": "Bu stul." },
    { "en": "It is an apple.",    "uz": "Bu olma." },
    { "en": "She is a doctor.",   "uz": "U shifokor." },
    { "en": "The shop is here.",  "uz": "Doʻkon bu yerda." }
  ],

  "warning": {
    "body": "Kasb aytganda artikl <b>albatta</b> kerak. Bu oʻzbeklarda eng uzoq qoladigan xato.\n\nSanalmaydigan narsalar oldida esa «a» qoʻyilmaydi: <b>water</b>, <b>bread</b>, <b>money</b> — bularni «bitta» deb sanab boʻlmaydi.",
    "pairs": [
