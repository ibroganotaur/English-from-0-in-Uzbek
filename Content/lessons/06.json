  "rules": [
    {
      "label": "Qoida · yaqin va uzoq",
      "body": "<b>this</b> — bu (yaqin, birlik)\n<b>these</b> — bular (yaqin, koʻplik)\n<b>that</b> — u, ana u (uzoq, birlik)\n<b>those</b> — ular (uzoq, koʻplik)\n\nKoʻplikda «is» emas, <b>are</b>:",
      "examples": [
        { "uz": "Bu stul.",      "en": "This is a chair." },
        { "uz": "Bular stullar.", "en": "These are chairs." }
      ]
    },
    {
      "label": "Qoida · savol berish",
      "body": "<b>What is this?</b> — Bu nima?\n<b>What are these?</b> — Bular nima?\n<b>Who is this?</b> — Bu kim?\n\nGapirganda qisqartiriladi: <b>What's this?</b>  <code>UOTS DHIS</code>",
      "examples": [
        { "uz": "Bu nima? — Bu telefon.",       "en": "What is this? — It is a phone." },
        { "uz": "Bu kim? — Bu mening singlim.", "en": "Who is this? — This is my sister." }
      ]
    },
    {
      "label": "Kunlik mashq",
      "body": "Uy boʻylab yuring va koʻrgan har bir narsani koʻrsatib ayting:\n\n<b>This is a table.</b>\n<b>That is a window.</b>\n<b>These are chairs.</b>\n\nKuniga 20 ta narsa. Bu — eng tez natija beradigan mashq.",
      "examples": []
    }
  ],

  "examples": [
    { "en": "This is a door.",        "uz": "Bu eshik." },
    { "en": "These are books.",       "uz": "Bular kitoblar." },
    { "en": "That is my house.",      "uz": "Ana u mening uyim." },
    { "en": "What is this? — Water.", "uz": "Bu nima? — Suv." }
  ],

  "warning": {
    "body": "«this» birlik, «these» koʻplik. Ularni almashtirib yubormang — bu juda tez seziladi.",
    "pairs": [
      { "bad": "This are books.",  "good": "These are books." },
      { "bad": "What is these?",   "good": "What are these?" },
      { "bad": "These is my car.", "good": "This is my car." }
    ]
  },

