  "rules": [
    {
      "label": "Qoida · -lar oʻrniga -s",
      "body": "Odatda oxiriga <b>-s</b> qoʻshiladi:\nbook → book<b>s</b>, chair → chair<b>s</b>\n\n<b>-s, -sh, -ch, -x, -o</b> dan keyin <b>-es</b>:\nbox → box<b>es</b>, watch → watch<b>es</b>\n\nUndoshdan keyingi <b>-y</b> → <b>-ies</b>:\ncity → cit<b>ies</b>, baby → bab<b>ies</b>",
      "examples": []
    },
    {
      "label": "Qoida · qoidaga boʻysunmaydiganlar",
      "body": "Bir nechta soʻz butunlay oʻzgaradi. Ularni yodlash kerak:\n\nman → <b>men</b>\nwoman → <b>women</b>  <code>UU-men → UI-min</code>\nchild → <b>children</b>\nfoot → <b>feet</b>",
      "examples": []
    }
  ],

  "examples": [
    { "en": "two books",           "uz": "ikkita kitob" },
    { "en": "three apples",        "uz": "uchta olma" },
    { "en": "The books are here.", "uz": "Kitoblar bu yerda." },
    { "en": "They are children.",  "uz": "Ular bolalar." }
  ],

  "warning": {
    "body": "Oʻzbekchada son bor boʻlsa «-lar» qoʻyilmaydi: «ikkita <b>kitob</b>».\n\nInglizchada esa son bor boʻlsa ham <b>-s</b> shart. Va koʻplik bilan «is» emas, <b>are</b> ishlatiladi.",
