  "rules": [
    {
      "label": "Qoida · egasi oldinga chiqadi",
      "body": "Oʻzbekchada «Men<b>da</b> mashina <b>bor</b>» — egasi «-da» qoʻshimchasi bilan.\n\nInglizchada egasi <b>gapning boshida</b> turadi va «have» feʼli ishlatiladi. «Bor» soʻzi alohida tarjima qilinmaydi — u «have» ning ichida.\n\nFaqat <b>he / she / it</b> bilan «has». Qolgan hammasi bilan «have».",
      "examples": [
        { "uz": "Menda mashina bor.",         "en": "I have a car." },
        { "uz": "Uning ikkita bolasi bor.",   "en": "She has two children." }
      ]
    },
    {
      "label": "Qoida · inkor va savol",
      "body": "Bu yerda yangi soʻz paydo boʻladi: <b>do</b> / <b>does</b>. U hech narsani anglatmaydi — faqat inkor va savol yasash uchun kerak boʻlgan <b>yordamchi soʻz</b>.\n\nHozircha shu shakllarni yodlab qoʻying, toʻliq qoida keyingi blokda beriladi.\n\nI <b>don't</b> have a car.\nShe <b>doesn't</b> have a car.\n<b>Do</b> you have a car?\n<b>Does</b> she have a car?\n\nDiqqat: «does» bor boʻlsa, «have» oddiy shaklga qaytadi — «does she <b>has</b>» emas.",
      "examples": []
    }
  ],

  "examples": [
    { "en": "I have money.",           "uz": "Menda pul bor." },
    { "en": "He has a job.",           "uz": "Uning ishi bor." },
    { "en": "I don't have time.",      "uz": "Menda vaqt yoʻq." },
    { "en": "Do you have a car?",      "uz": "Sizda mashina bormi?" }
  ],

  "warning": {
    "body": "«he / she / it» bilan har doim <b>has</b>. Va oʻzbekcha «menda» tuzilishini soʻzma-soʻz tarjima qilmang.",
    "pairs": [
      { "bad": "He have a car.",        "good": "He has a car." },
      { "bad": "In me there is a car.", "good": "I have a car." },
      { "bad": "Does she has a car?",   "good": "Does she have a car?" }
    ]
  },

